# Copy to .env (or set these in your host's dashboard).

# Port the server listens on.
PORT=3001

# Where the SQLite database lives. Put this on a persistent disk/volume.
DATA_DIR=./data
# DB_FILE=./data/sunnyport.db

# Browser origins allowed to open a socket, comma-separated. Leave empty to
# allow only same-origin traffic through the bundled client.
ALLOWED_ORIGINS=https://play.example.com

# Set when running behind a proxy/load balancer (Render, Fly, Nginx…), so
# rate limits see the real client IP. "true" trusts every hop; a number
# trusts that many hops.
TRUST_PROXY=1

# Session cookies are Secure (HTTPS-only) in production. Set to 0 only for
# local testing of a production build over plain http.
# COOKIE_SECURE=0
