# Caddy sits in front of the game: it gets and renews the HTTPS certificate
# on its own and passes every request (including live sockets) to the app.
# DOMAIN comes from the .env file next to docker-compose.prod.yml.

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3001
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
